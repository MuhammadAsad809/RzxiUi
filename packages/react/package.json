{
  "name": "@rzxiui/react",
  "version": "0.1.0",
  "description": "Liquid UI accessible glass, motion, and 3D components for React",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three-entry.d.ts",
      "import": "./dist/three.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "framer-motion": ">=11",
    "gsap": ">=3",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.170"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": { "optional": true },
    "@react-three/fiber": { "optional": true },
    "three": { "optional": true }
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.177.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.177.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.0"
  }
}
